{
  "schemaVersion": 1,
  "id": "io.github.alarmguypro.powerstation",
  "name": "PowerStation",
  "version": "0.2.1",
  "author": "KQ4WLR",
  "description": "Control and monitor Shelly relays, plugs and dimmers on your LAN from Zeus: on/off, dimming, scenes and live power readings.",
  "homepage": "https://github.com/AlarmGuyPro/zeus-powerstation",
  "license": "GPL-2.0-or-later",
  "sdk": {
    "abi": 1,
    "minVersion": "1.5.0"
  },
  "entrypoint": {
    "assembly": "KQ4WLR.PowerStation.dll",
    "type": "KQ4WLR.PowerStation.PowerStationPlugin"
  },
  "capabilities": [
    "NetworkAccess",
    "PersistSettings"
  ],
  "permissions": {
    "network": true,
    "fileSystemRead": false,
    "fileSystemWrite": false
  },
  "ui": {
    "modules": [
      "ui/powerstation.js"
    ],
    "panels": [
      {
        "id": "powerstation-controls",
        "title": "PowerStation",
        "icon": "Power",
        "slot": "workspace.powerstation-controls",
        "category": "switches"
      },
      {
        "id": "powerstation-devices",
        "title": "PowerStation Setup",
        "icon": "Settings",
        "slot": "workspace.powerstation-devices",
        "category": "switches"
      }
    ]
  }
}
