{
  "schemaVersion": 1,
  "id": "io.github.alarmguypro.powerstation",
  "name": "PowerStation",
  "version": "0.5.1",
  "author": "KQ4WLR",
  "description": "Control and monitor Shelly relays, plugs, dimmers and energy meters (Gen1 to Gen4) on your LAN from Zeus: discovery, scenes, rules driven by Zeus start/close, band, frequency, TX and idle time, safety timers, and voltage and current ranges.",
  "homepage": "https://github.com/AlarmGuyPro/zeus-powerstation",
  "license": "GPL-2.0-or-later",
  "sdk": {
    "abi": 1,
    "minVersion": "1.5.0"
  },
  "entrypoint": {
    "assembly": "KQ4WLR.PowerStation.dll",
    "type": "KQ4WLR.PowerStation.PowerStationPlugin"
  },
  "capabilities": [
    "ReadRadioState",
    "NetworkAccess",
    "PersistSettings"
  ],
  "permissions": {
    "network": true,
    "fileSystemRead": false,
    "fileSystemWrite": false
  },
  "ui": {
    "modules": [
      "ui/powerstation.js"
    ],
    "panels": [
      {
        "id": "powerstation-controls",
        "title": "PowerStation",
        "icon": "Power",
        "slot": "workspace.powerstation-controls",
        "category": "switches"
      },
      {
        "id": "powerstation-idle",
        "title": "PowerStation Idle",
        "icon": "Timer",
        "slot": "workspace.powerstation-idle",
        "category": "switches"
      }
    ]
  }
}
